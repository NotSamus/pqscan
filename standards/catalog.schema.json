{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "reviewed_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "coverage": {
      "const": "partial"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "excluded_topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "catalog_id",
    "version",
    "reviewed_on",
    "coverage",
    "scope",
    "excluded_topics",
    "sources",
    "requirements"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publication_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "edition": {
          "const": "final"
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "publication_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "errata": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "reviewed",
                "none_listed"
              ]
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https://[^\\s]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "checked_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "disposition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "url",
            "sha256",
            "checked_on",
            "disposition"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "title",
        "publication_date",
        "edition",
        "url",
        "publication_url",
        "sha256",
        "reviewed_on",
        "errata"
      ],
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "enum": [
            "ML-KEM",
            "ML-DSA",
            "SLH-DSA"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "obligation": {
          "enum": [
            "shall",
            "must",
            "algorithm_definition",
            "recommendation",
            "project_policy"
          ]
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1
        },
        "verification_methods": {
          "type": "array",
          "items": {
            "enum": [
              "provider_contract_review",
              "negative_tests",
              "known_answer_tests",
              "randomness_failure_tests",
              "protocol_review",
              "protocol_negative_tests",
              "key_lifecycle_tests"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reviewed_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "errata_disposition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source_id",
        "locator",
        "algorithm",
        "title",
        "obligation",
        "applicability",
        "expected_behavior",
        "verification_methods",
        "reviewed_on",
        "errata_disposition"
      ],
      "additionalProperties": false
    }
  }
}
